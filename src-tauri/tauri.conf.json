{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Business Flow Explorer",
  "version": "0.1.0",
  "identifier": "dev.renasanh.businessflowexplorer",
  "build": {
    "beforeDevCommand": "npm --prefix web run dev -- --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix web run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Business Flow Explorer",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ]
  }
}
