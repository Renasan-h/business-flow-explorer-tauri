{
  "name": "business-flow-explorer-tauri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "tsc --noEmit && vite build",
    "prebuild:web": "node scripts/generate-scenario-manifest.mjs",
    "preview": "vite preview",
    "predev": "node scripts/generate-icon.mjs",
    "prebuild": "node scripts/generate-icon.mjs",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "npm run test:unit && npm run test:e2e && npm run test:rust",
    "test:unit": "npm run build:web && node scripts/check-version.mjs && node scripts/test-scenario-fragments.mjs",
    "test:e2e": "node scripts/test-editor-e2e.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm run test && npm run check",
    "check:version": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "pixi.js": "8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "@tauri-apps/api": "2.12.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "@vitejs/plugin-react": "5.2.0",
    "@tauri-apps/cli": "2.12.5",
    "playwright": "1.65.1"
  }
}
